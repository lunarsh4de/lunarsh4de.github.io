---
import BaseLayout from '../layouts/BaseLayout.astro';
import PortfolioImage from '../components/PortfolioImage.astro';
import { homeProjects, layout, site } from '../data/site';
import '../styles/portfolio.css';
---
<BaseLayout title={site.name} >
  <div class="reference-home homepage-showcase">
    <aside class="reference-sidebar">
      <div class="reference-mobile-bar"><a class="reference-brand" href="/">{site.name}</a><button class="reference-menu" type="button" aria-expanded="false" aria-controls="reference-nav">Menu</button></div>
      <div class="reference-sidebar-inner">
        <a class="reference-brand" href="/">{site.name}</a>
        <p class="reference-tagline"><span>Product strategy,<br />human factors &amp; hardware</span></p>
        <nav class="reference-nav" id="reference-nav" aria-label="Portfolio navigation">
          <a class="is-current" href="/work/">Design projects</a>
          <a href="/notes/">Blog</a><a href="/about/">About</a><a href={`mailto:${site.email}`}>Contact</a>
        </nav>
        <div class="reference-sidebar-foot"><span class="mono">{site.location}</span><span class="mono">© 2026</span></div>
      </div>
    </aside>
    <div class="portfolio-home-content">
      <header class="portfolio-home-heading"><div><p class="mono">SELECTED WORK / 2020–2026</p><h1>Bringing ideas into everyday life.</h1></div><p>Products · Systems · Digital experiences<br /><span>{String(homeProjects.length).padStart(2,'0')} design projects</span></p></header>
      <section class="product-feed portfolio-feed" aria-label="Design projects">
        {homeProjects.map((project, index) => {
          const tile = layout.homepage.projectLayout[project.slug];
          return <a class={`product-poster portfolio-poster portfolio-poster--${project.slug}`} id={`project-${String(index+1).padStart(2,'0')}`} href={`/work/${project.slug}/`} style={`--card-color:${project.color};grid-column:span ${tile.columns};grid-row:span ${tile.rows}`}>
            <PortfolioImage src={project.image!} alt={project.hero} eager={index === 0} />
            <span class="portfolio-poster-index mono">{String(index+1).padStart(2,'0')} / {String(homeProjects.length).padStart(2,'0')}</span>
            <span class="portfolio-poster-label"><span>{project.category}</span><strong>{project.title}</strong><span>{project.subtitle}</span></span>
            <span class="portfolio-poster-arrow" aria-hidden="true">↗</span>
          </a>;
        })}
      </section>
      <footer class="portfolio-home-foot"><span class="mono">ZICHEN YANG / DESIGN PORTFOLIO</span><a href={`mailto:${site.email}`}>Start a conversation ↗</a></footer>
    </div>
  </div>
</BaseLayout>
