---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PortfolioImage from '../../components/PortfolioImage.astro';
import { projects, homeProjects } from '../../data/site';
import '../../styles/portfolio.css';

export async function getStaticPaths() {
  const stories = await getCollection('projects');
  return projects.map((project) => {
    const story = stories.find((entry) => entry.id === project.slug);
    if (!story) throw new Error(`Missing case study: ${project.slug}`);
    return { params: { slug: project.slug }, props: { project, story } };
  });
}
const { project, story } = Astro.props;
const { Content, headings: allHeadings } = await render(story);
const headings = allHeadings.filter((h) => h.depth === 2);
const position = homeProjects.findIndex((item) => item.slug === project.slug);
const next = homeProjects[(position + 1) % homeProjects.length];
---
<BaseLayout title={project.title} description={project.intro}  socialImage={project.image}>
  <article class={`portfolio-case portfolio-case--${project.slug}`} style={`--project-color:${project.color}`}>
    <header class="portfolio-case-head" id="project-top">
      <div class="case-topline"><a href="/work/">← All projects</a><span class="mono">{String(position + 1).padStart(2, '0')} / {String(homeProjects.length).padStart(2, '0')}</span></div>
      <p class="case-category">{project.category}</p>
      <h1>{project.title}</h1>
      <p class="case-subtitle">{project.subtitle}</p>
      <p class="case-intro">{project.intro}</p>
    </header>
    <figure class="case-cover">
      <a href={project.image} data-lightbox aria-label={`Enlarge image: ${project.hero}`} target="_blank" rel="noopener">
        <PortfolioImage src={project.image!} alt={project.hero} eager />
        <span class="image-enlarge" aria-hidden="true">↗</span>
      </a>
    </figure>
    <dl class="portfolio-facts">{project.facts.map((fact) => <div><dt>{fact.label}</dt><dd>{fact.value}</dd></div>)}</dl>
    <div class="case-reader">
      <nav class="case-toc" aria-label="Project sections">
        <p class="mono">IN THIS PROJECT</p>
        <ol>{headings.map((h, i) => <li><a href={`#${h.slug}`}><span>{String(i+1).padStart(2,'0')}</span>{h.text}</a></li>)}</ol>
        <a class="case-top-link" href="#project-top">Back to top ↑</a>
      </nav>
      <div class="case-prose" lang="en"><Content /></div>
    </div>
    <footer class="portfolio-next">
      <a href="/work/" class="all-projects-link">← All projects</a>
      <a href={`/work/${next.slug}/`} class="next-project"><span class="mono">NEXT PROJECT</span><strong>{next.title} <span>↗</span></strong><span>{next.subtitle}</span></a>
    </footer>
  </article>
  <dialog class="image-dialog" aria-labelledby="image-dialog-caption">
    <div class="image-dialog-toolbar"><p id="image-dialog-caption"></p><div><button type="button" data-image-zoom aria-pressed="false">Actual size</button><button type="button" data-image-close aria-label="Close image">Close ×</button></div></div>
    <div class="image-dialog-scroll"><img alt="" /></div>
  </dialog>
  <script>
    import '../../scripts/case-study';
  </script>
</BaseLayout>
