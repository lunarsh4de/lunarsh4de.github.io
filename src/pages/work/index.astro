---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PortfolioImage from '../../components/PortfolioImage.astro';
import { homeProjects } from '../../data/site';
import '../../styles/portfolio.css';
---
<BaseLayout title="Design projects">
  <header class="portfolio-archive-head"><p class="mono">SELECTED WORK / 2020–2026</p><h1>Design projects</h1><p>Exploring products, systems and digital experiences through the contexts in which they are used.</p></header>
  <section class="portfolio-archive" aria-label="Design projects">
    {homeProjects.map((project,index) => <a class={`portfolio-archive-card portfolio-archive-card--${project.slug}`} href={`/work/${project.slug}/`}>
      <div class="portfolio-archive-image" style={`background:${project.color}`}><PortfolioImage src={project.image!} alt={project.hero} eager={index === 0} /><span class="mono">{String(index+1).padStart(2,'0')}</span></div>
      <div class="portfolio-archive-copy"><p>{project.category}</p><h2>{project.title}<span aria-hidden="true">↗</span></h2><p>{project.short}</p></div>
    </a>)}
  </section>
</BaseLayout>
