---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { articles, publicationDate } from '../../data/wechat';
import '../../styles/wechat.css';

export function getStaticPaths() {
  return articles.map((article) => ({ params: { slug: article.slug }, props: { article } }));
}

const { article } = Astro.props;
---
<BaseLayout title={article.display.title} description={article.display.excerpt} socialImage={article.cover || undefined}>
  <article class="wechat-detail section-pad">
    <a class="back-link" href="/notes/">← All articles</a>
    <header class="wechat-detail-head"><p class="eyebrow"><span class="eyebrow-mark"></span>WeChat / Original article in Chinese</p><h1>{article.display.title}</h1><div class="wechat-byline"><span>Design &amp; AI</span><time datetime={article.publishedAt}>{publicationDate(article.publishedAt)}</time><a href={article.sourceUrl} target="_blank" rel="noopener noreferrer">Read on WeChat ↗</a></div></header>
    <div class="wechat-prose" lang="zh-CN" set:html={article.contentHtml} />
    <footer class="wechat-detail-foot"><p>Originally published on WeChat: Design &amp; AI.</p><a class="arrow-link" href={article.sourceUrl} target="_blank" rel="noopener noreferrer">Read and comment on WeChat <span aria-hidden="true">↗</span></a><a class="back-link" href="/notes/">← All articles</a></footer>
  </article>
</BaseLayout>
