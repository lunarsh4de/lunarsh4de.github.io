---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { articles, wechat, publicationDate } from '../../data/wechat';
import '../../styles/wechat.css';
---
<BaseLayout title="Blog" description="Articles on AI, design tools and everyday practice, originally published in Chinese on WeChat.">
  <section class="wechat-head section-pad">
    <p class="eyebrow"><span class="eyebrow-mark"></span>Blog / WeChat journal</p>
    <div class="wechat-heading"><h1>Blog<span class="wechat-heading-dot">.</span></h1><p>AI, design tools and everyday practice.<br />Original articles in Chinese from my WeChat publication.</p></div>
    <div class="wechat-archive-meta"><span class="mono">{String(articles.length).padStart(2, '0')} articles · Chinese</span><a class="arrow-link" href={wechat.accountArticleUrl} target="_blank" rel="noopener noreferrer">Read on WeChat <span aria-hidden="true">↗</span></a></div>
  </section>
  <section class="wechat-archive section-pad" aria-label="Blog articles">
    {articles.map((article, index) => <a class="wechat-article-card" href={`/notes/${article.slug}/`}>
      <div class="wechat-card-media">{article.cover ? <img src={article.cover} alt="" loading={index === 0 ? 'eager' : 'lazy'} width="960" height="540" /> : <span class="wechat-card-wordmark" aria-hidden="true">Design &amp; AI<span>JOURNAL / {String(index+1).padStart(2,'0')}</span></span>}</div>
      <div class="wechat-card-copy"><p class="wechat-card-meta"><time datetime={article.publishedAt}>{publicationDate(article.publishedAt)}</time><span>WeChat · Chinese</span></p><h2 lang="zh-CN">{article.title}</h2><p class="wechat-card-excerpt" lang="zh-CN">{article.excerpt}</p><span class="wechat-read-link">Read article <span aria-hidden="true">→</span></span></div>
    </a>)}
    {!articles.length && <p class="wechat-empty">Articles are being added. You can read them on WeChat.<a href={wechat.accountArticleUrl} target="_blank" rel="noopener noreferrer">Read on WeChat ↗</a></p>}
  </section>
</BaseLayout>
