---
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/overrides.css';
import { site } from '../data/site';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title?: string;
  description?: string;
  contentLang?: string;
  socialImage?: string;
}

const { title = site.name, description = site.statement, contentLang, socialImage } = Astro.props;
const isHome = Astro.url.pathname === '/';
const isPanel = !isHome;
const isNotes = Astro.url.pathname.startsWith('/notes');
const isWork = Astro.url.pathname.startsWith('/work');
---
<!doctype html>
<html lang={contentLang ?? 'en'} data-content-lang={contentLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:title" content={`${title} — Zichen Yang`} />
    <meta property="og:description" content={description} />
    {socialImage && <meta property="og:image" content={new URL(socialImage, Astro.site)} />}
    <ClientRouter />
    <title>{title} — Product development</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700&family=Newsreader:opsz,wght@6..72,400;6..72,500&display=swap" rel="stylesheet" />
  </head>
  <body class:list={[isHome && 'is-reference-home', isPanel && 'is-panel-page']}>
    <div class="cursor-dot" aria-hidden="true"></div>
    {isHome ? (
      <>
        <header class="site-header">
          <a class="brand" href="/"><span class="brand-mark">Y</span><span>YANG / PRODUCT DESIGN</span></a>
          <a class="header-contact" href={`mailto:${site.email}`}>Contact <span>↗</span></a>
          <div class="language-switch" data-language-switch aria-label="Language"><button type="button" data-language="cn">CN</button><span>/</span><button type="button" data-language="en">EN</button></div>
        </header>
        <main><slot /></main>
        <footer class="site-footer"><span>© 2026 {site.name}</span><span>{site.location}</span><span class="mono">V.01 / STATIC BUILD</span></footer>
      </>
    ) : (
      <div class="reference-home reference-inner-page">
        <aside class="reference-sidebar">
          <button class="sidebar-edge-toggle" type="button" aria-expanded="false" aria-controls="reference-nav" aria-label="Expand navigation"><span aria-hidden="true">☰</span></button>
          <div class="reference-mobile-bar"><a class="reference-brand" href="/">{site.name}</a><button class="reference-menu" type="button" aria-expanded="false" aria-controls="reference-nav">Menu</button></div>
          <div class="reference-sidebar-inner">
            <a class="reference-brand" href="/">{site.name}</a>
            <p class="reference-tagline"><span data-i18n="tagline" data-cn="产品策略，<br />人因研究与硬件开发" data-en="Product strategy,<br />human factors & hardware">Product strategy,<br />human factors &amp; hardware</span></p>
            <nav class="reference-nav" id="reference-nav" aria-label="Portfolio navigation">
              <a class:list={[(isHome || isWork) && 'is-current']} href="/?skipIntro=1#project-01" data-skip-intro>Design projects</a>
              <a class:list={[isNotes && 'is-current']} href="/notes/">Notes</a>
              <a class:list={[Astro.url.pathname.startsWith('/about') && 'is-current']} href="/about/">About</a>
              <a href={`mailto:${site.email}`}>Contact</a>
            </nav>
            <div class="reference-sidebar-foot"><span class="mono">{site.location}</span><span class="mono">© 2026</span><div class="language-switch language-switch--rail" data-language-switch aria-label="Language"><button type="button" data-language="cn">CN</button><span>/</span><button type="button" data-language="en">EN</button></div></div>
          </div>
        </aside>
        <main class="reference-content"><slot /></main>
      </div>
    )}
    <script is:inline>
      (() => {
        const initLanguage = () => {
          const switches = document.querySelectorAll('[data-language-switch]');
          const labels = document.querySelectorAll('[data-i18n]');
          if (!switches.length && !labels.length) return;
          const stored = window.localStorage.getItem('lin-language');
          const language = stored === 'cn' ? 'cn' : 'en';
          document.documentElement.lang = document.documentElement.dataset.contentLang || (language === 'cn' ? 'zh-CN' : 'en');
          labels.forEach((label) => {
            const value = label.dataset[language];
            if (value) label.innerHTML = value;
          });
          switches.forEach((switcher) => {
            switcher.querySelectorAll('[data-language]').forEach((button) => {
              button.classList.toggle('is-active', button.dataset.language === language);
              button.setAttribute('aria-pressed', String(button.dataset.language === language));
              if (button.dataset.language === language || button.dataset.bound) return;
              button.dataset.bound = 'true';
              button.addEventListener('click', () => {
                window.localStorage.setItem('lin-language', button.dataset.language);
                initLanguage();
              });
            });
          });
        };
        initLanguage();
        document.addEventListener('astro:page-load', initLanguage);
        document.addEventListener('astro:after-swap', initLanguage);
      })();
    </script>
    <script is:inline>
      (() => {
        const initCursor = () => {
          const finePointer = window.matchMedia('(pointer: fine)');
          if (!finePointer.matches) return;
          if (!window.__linCursorStarted) {
            let pointerX = window.innerWidth / 2;
            let pointerY = window.innerHeight / 2;
            let dotX = pointerX;
            let dotY = pointerY;
            const move = (event) => {
              pointerX = event.clientX;
              pointerY = event.clientY;
            };
            const render = () => {
              dotX += (pointerX - dotX) * 0.18;
              dotY += (pointerY - dotY) * 0.18;
              const currentDot = document.querySelector('.cursor-dot');
              if (currentDot) currentDot.style.transform = `translate3d(${dotX}px, ${dotY}px, 0)`;
              requestAnimationFrame(render);
            };
            window.addEventListener('pointermove', move, { passive: true });
            render();
            window.__linCursorStarted = true;
          }
          document.querySelectorAll('a, button, model-viewer').forEach((element) => {
            if (element.dataset.cursorBound) return;
            element.dataset.cursorBound = 'true';
            element.addEventListener('mouseenter', () => document.body.classList.add('cursor-hover'));
            element.addEventListener('mouseleave', () => document.body.classList.remove('cursor-hover'));
          });
        };
        initCursor();
        document.addEventListener('astro:page-load', initCursor);
      })();
    </script>
    <script>
      import '../scripts/navigation';
    </script>
    <script is:inline>
      (() => {
        const initIntro = () => {
          const intro = document.querySelector('[data-intro]');
          if (!intro) return;
          const skipFromQuery = new URLSearchParams(window.location.search).has('skipIntro');
          const skipFromStorage = sessionStorage.getItem('lin-skip-intro') === '1';
          if (skipFromQuery || skipFromStorage) {
            sessionStorage.removeItem('lin-skip-intro');
            intro.remove();
            if (skipFromQuery) window.history.replaceState({}, '', `${window.location.pathname}${window.location.hash}`);
            return;
          }
          if (intro.dataset.bound) return;
          intro.dataset.bound = 'true';
          const enterButton = intro.querySelector('[data-enter]');
          let isLeaving = false;
          const enter = () => {
            if (isLeaving) return;
            isLeaving = true;
            intro.classList.add('is-hidden');
            intro.setAttribute('aria-hidden', 'true');
            window.setTimeout(() => intro.remove(), 850);
          };
          enterButton?.addEventListener('click', enter);
          enterButton?.focus({ preventScroll: true });
          window.addEventListener('keydown', (event) => {
            if (event.key === 'Enter' || event.key === ' ') enter();
          }, { once: true });
        };
        initIntro();
        if (!window.__linIntroLifecycleBound) {
          document.addEventListener('astro:page-load', initIntro);
          window.__linIntroLifecycleBound = true;
        }
      })();
    </script>
  </body>
</html>
