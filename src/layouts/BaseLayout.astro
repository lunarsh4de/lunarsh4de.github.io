---
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/overrides.css';
import '../styles/cursor.css';
import { site } from '../data/site';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title?: string;
  description?: string;
  socialImage?: string;
}

const { title = site.name, description = site.statement, socialImage } = Astro.props;
const isHome = Astro.url.pathname === '/';
const isPanel = !isHome;
const isNotes = Astro.url.pathname.startsWith('/notes');
const isWork = Astro.url.pathname.startsWith('/work');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:title" content={`${title} — Zichen Yang`} />
    <meta property="og:description" content={description} />
    {socialImage && <meta property="og:image" content={new URL(socialImage, Astro.site)} />}
    <ClientRouter />
    <noscript><style>
      .reference-inner-page .reference-sidebar{position:relative!important;width:auto!important;height:auto!important}
      .reference-home.reference-inner-page{display:block}
      .reference-sidebar .reference-sidebar-inner{position:static!important;width:auto!important;height:auto!important;min-height:0!important;max-height:none!important;padding:24px!important;visibility:visible!important;opacity:1!important;overflow:visible!important}
      .reference-menu,.sidebar-edge-toggle{display:none!important}
    </style></noscript>
    <title>{title} — Product development</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700&family=Newsreader:opsz,wght@6..72,400;6..72,500&display=swap" rel="stylesheet" />
  </head>
  <body class:list={[isHome && 'is-reference-home', isPanel && 'is-panel-page']}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    {isHome ? (
      <>
        <header class="site-header">
          <a class="brand" href="/"><span class="brand-mark">Y</span><span>YANG / PRODUCT DESIGN</span></a>
          <a class="header-contact" href={`mailto:${site.email}`}>Contact <span>↗</span></a>
        </header>
        <main id="main-content" tabindex="-1"><slot /></main>
        <footer class="site-footer"><span>© 2026 {site.name}</span><span>{site.location}</span><span class="mono">V.01 / STATIC BUILD</span></footer>
      </>
    ) : (
      <div class="reference-home reference-inner-page">
        <aside class="reference-sidebar">
          <button class="sidebar-edge-toggle" type="button" aria-expanded="false" aria-controls="reference-nav" aria-label="Expand navigation"><span aria-hidden="true">☰</span></button>
          <div class="reference-mobile-bar"><a class="reference-brand" href="/">{site.name}</a><button class="reference-menu" type="button" aria-expanded="false" aria-controls="reference-nav">Menu</button></div>
          <div class="reference-sidebar-inner">
            <a class="reference-brand" href="/">{site.name}</a>
            <p class="reference-tagline"><span>Product strategy,<br />human factors &amp; hardware</span></p>
            <nav class="reference-nav" id="reference-nav" aria-label="Portfolio navigation">
              <a class:list={[isWork && 'is-current']} aria-current={isWork ? 'page' : undefined} href="/work/">Design projects</a>
              <a class:list={[isNotes && 'is-current']} aria-current={isNotes ? 'page' : undefined} href="/notes/">Blog</a>
              <a class:list={[Astro.url.pathname.startsWith('/about') && 'is-current']} aria-current={Astro.url.pathname.startsWith('/about') ? 'page' : undefined} href="/about/">About</a>
              <a href={`mailto:${site.email}`}>Contact</a>
            </nav>
            <div class="reference-sidebar-foot"><span class="mono">{site.location}</span><span class="mono">© 2026</span></div>
          </div>
        </aside>
        <main id="main-content" class="reference-content" tabindex="-1"><slot /></main>
      </div>
    )}
    <script>
      import '../scripts/navigation';
    </script>
  </body>
</html>
